rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================
    // HELPERS
    // ====================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    // Fields a normal user may never write about themselves — only admin (or
    // Cloud Functions via Admin SDK, which bypasses rules entirely).
    function isPrivilegedFieldChange() {
      let changed = request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys();
      return changed.hasAny(['tier', 'total_xp', 'level', 'total_scans', 'plants_unlocked',
        'normal_count', 'rare_count', 'special_rare_count', 'daily_scans_limit',
        'daily_scans_used', 'last_scan_date', 'trial_ends_at', 'achievements_earned',
        'deleted_at', 'admin']);
    }

    // ====================
    // PLANTS (public read, admin write)
    // ====================
    match /plants/{plantId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ====================
    // USERS (owner reads + edits profile basics; progression & tier are
    // server-managed ONLY — Cloud Functions/Admin SDK writes bypass rules)
    // ====================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if false; // auth trigger (Admin SDK) provisions this doc
      allow update: if isAdmin()
        || (isOwner(userId) && !isPrivilegedFieldChange());
      allow delete: if isAdmin(); // users may not hard-delete their own record (GDPR via support/admin)
    }

    // ====================
    // USER_PLANTS (server-managed collection — functions write via Admin SDK)
    // No client writes allowed: unlocks/XP are awarded by identifyPlant only.
    // ====================
    match /user_plants/{docId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow write: if isAdmin();
    }

    // ====================
    // ACHIEVEMENTS (public read, admin write)
    // ====================
    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ====================
    // USER_ACHIEVEMENTS (server-managed: evaluateAchievements awards them)
    // ====================
    match /user_achievements/{docId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ====================
    // SCANS (owner read, function-created via Admin SDK; no client writes)
    // ====================
    match /scans/{scanId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ====================
    // UNVERIFIED_PLANTS (any auth user contributes one; admin curates)
    // ====================
    match /unverified_plants/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.keys().hasAll(['scientific_name', 'status'])
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ====================
    // FLAGGED_PHOTOS (admin only)
    // ====================
    match /flagged_photos/{docId} {
      allow read, write: if isAdmin();
    }

    // ====================
    // AI SUPPORT TABLES (server-managed only — Admin SDK writes, no client
    // access at all; the mobile app never reads these directly)
    // ====================
    match /plant_safety/{speciesId} {
      allow read, write: if false; // Cloud Functions Admin SDK bypasses rules
    }
    match /enrich_requests/{requestId} {
      allow read, write: if false;
    }
    match /daily_counters/{docId} {
      allow read, write: if false;
    }
  }
}