# UrPlant AI Configuration — EXAMPLE FILE (safe to commit)
# 
# Copy this to functions/.env and fill in your actual keys.
# functions/.env is gitignored and will NEVER be committed.
#
# For production, migrate to Firebase Secret Manager:
#   firebase functions:secrets:set OPENAI_VISION_KEY
#   firebase functions:secrets:set SELF_HOSTED_AI_KEY

# ─── AI Provider Selection ─────────────────────────────────────
# Options: openai_vision_gateway | self_hosted_vlm | plantid
AI_PROVIDER=openai_vision_gateway

# ─── Vision Gateway (airouter-kh.fly.dev) ─────────────────────
OPENAI_VISION_URL=https://airouter-kh.fly.dev/v1/chat/completions
OPENAI_VISION_KEY=sk-replace-with-your-actual-key
OPENAI_VISION_MODEL=gpt-4o-mini

# ─── Text Enrichment + KH Translation ──────────────────────────
SELF_HOSTED_AI_URL=https://airouter-kh.fly.dev/v1/chat/completions
SELF_HOSTED_AI_KEY=sk-replace-with-your-actual-key
SELF_HOSTED_AI_MODEL=deepseek-chat

# ─── Optional: Ollama Local VLM ────────────────────────────────
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2-vl:7b

# ─── Optional: Plant.id API ────────────────────────────────────
# PLANT_ID_API_KEY=
# PLANT_ID_API_URL=https://api.plant.id/v3